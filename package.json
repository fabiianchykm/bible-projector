{
  "name": "bible-projector",
  "version": "1.0.12",
  "description": "Програма для виводу місць з Біблії на проектор",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.bibleprojector",
    "publish": {
      "provider": "github",
      "owner": "fabiianchykm",
      "repo": "bible-projector"
    },
    "extraResources": [
      {
        "from": "translations",
        "to": "translations",
        "filter": [
          "**/*"
        ]
      }
    ],
    "productName": "Bible Projector",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "icon-mac.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "keywords": [],
  "author": "Your Name or Company",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.60.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.0",
    "electron-log": "^5.1.6",
    "electron-updater": "^6.2.1"
  },
  "type": "commonjs"
}
